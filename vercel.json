{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "gsseleva.com.br" }],
      "destination": "/eleva",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.gsseleva.com.br" }],
      "destination": "/eleva",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/eleva", "destination": "/index.html" },
    { "source": "/eleva/(.*)", "destination": "/index.html" }
  ]
}
