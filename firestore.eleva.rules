rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gestores autorizados (espelha GESTOR_EMAILS do app).
    function isGestor() {
      return request.auth != null &&
        request.auth.token.email in ['viviangitti@gmail.com', 'viviangitti23@gmail.com'];
    }
    // Perfil do usuário: cada pessoa lê e grava SÓ o próprio doc (papel/nome/canal).
    match /elevaUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Conteúdo do Eleva: quem está logado LÊ; só o gestor ESCREVE.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isGestor();
    }
  }
}
