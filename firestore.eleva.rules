rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Gestores autorizados (espelha GESTOR_EMAILS do app).
    // Espelha GESTOR_EMAILS do app (src/pilulas/AuthContext.tsx). Mudou lá,
    // muda aqui — senão a pessoa vê os campos de vídeo mas não salva na nuvem.
    function isGestor() {
      return request.auth != null &&
        request.auth.token.email in ['maria26@gmail.com', 'viviangitti@gmail.com', 'viviangitti23@gmail.com'];
    }
    // Perfil do usuário: cada pessoa lê e grava SÓ o próprio doc (papel/nome/canal).
    match /elevaUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Uso do app (pílulas/quiz/missões): cada pessoa grava SÓ o próprio doc.
    // LEITURA: a própria pessoa, e o gestor da marca (precisa pra montar o painel
    // — sem isso o painel só mostraria número de exemplo). Vendedor não lê o do
    // colega. O Sistema de Gestão lê via Admin SDK, que passa por cima das regras.
    match /elevaStats/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isGestor());
      allow list: if isGestor();
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // Conteúdo do Eleva: quem está logado LÊ; só o gestor ESCREVE.
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if isGestor();
    }
  }
}
